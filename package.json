{
  "name": "diner-town",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A restaurant management sim in the spirit of Playfish's Restaurant City. Runs in any modern browser on mobile and desktop.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "esbuild tools/checks.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/checks.mjs --log-level=warning && node node_modules/.cache/checks.mjs",
    "deploy": "bash tools/deploy-pages.sh",
    "verify:live": "node tools/verify-live.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
